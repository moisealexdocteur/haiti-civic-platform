CI_ENVIRONMENT=development

APP_BASE_URL=http://127.0.0.1:18090/

DB_DATABASE=civic_platform
DB_USERNAME=civic
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

APP_KEY=CHANGE_ME
NINU_HMAC_KEY=CHANGE_ME

# OTP WhatsApp direct via Meta Cloud API.
# Laisser WHATSAPP_PROVIDER vide tant que la configuration n'est pas prête.
WHATSAPP_PROVIDER=
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_TEMPLATE_LANG=fr

# Secours SMS optionnel. Actuellement: Twilio.
# Laisser SMS_PROVIDER vide pour désactiver le secours SMS.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# Tests uniquement - ne jamais réutiliser les clés réelles
TEST_APP_KEY=CHANGE_ME
TEST_NINU_HMAC_KEY=CHANGE_ME

LOCAL_HTTP_PORT=18090
